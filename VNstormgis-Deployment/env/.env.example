# ==============================================================================
# VIETNAM WEATHER WEBGIS - LOCAL DEVELOPMENT ENVIRONMENT CONFIGURATION
# ==============================================================================
# Hướng dẫn: Sao chép tệp này thành .env.local và chỉnh sửa thông số phù hợp
# Command: cp deployment/env/.env.example deployment/env/.env.local

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL 16 + PostGIS 3.4)
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=weather_gis_db
DB_USERNAME=gis_user
DB_PASSWORD=gis_password_secret

# ------------------------------------------------------------------------------
# 2. CACHE CONFIGURATION (Redis 7.2)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Cờ bật/tắt tầng đệm GeoJSON 3 vùng TTL (Task W3-03). false = mọi lượt gọi truy vấn
# PostGIS trực tiếp, không đọc/ghi Redis (fail-open cho kiểm thử hồi quy).
REDIS_CACHE_ENABLED=true
# Giới hạn bộ nhớ và chính sách thu hồi Redis (Task W6-04 / D-W5-05-02):
# volatile-lru kết hợp 256mb bảo đảm đủ dung lượng cho 3 vùng cache GeoJSON và
# các bucket rate-limit Bucket4j mà không gây evict sớm trong cửa sổ 60s.
REDIS_MAXMEMORY=256mb
REDIS_MAXMEMORY_POLICY=volatile-lru

# Danh sách IP/CIDR của Reverse Proxy tin cậy cho bộ giới hạn tốc độ Chat (Task W5-05 / W6-04):
# Để trống khi chạy trực tiếp không qua proxy; đặt IP của Nginx/ALB khi chạy sau Reverse Proxy.
CHAT_RATELIMIT_TRUSTED_PROXIES=127.0.0.1

# ------------------------------------------------------------------------------
# 3. BACKEND API SERVICE (Spring Boot 3.3)
# ------------------------------------------------------------------------------
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# ------------------------------------------------------------------------------
# 4. FRONTEND APPLICATION (React + Vite)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8080

# ------------------------------------------------------------------------------
# 5. EXTERNAL API KEYS (Cung cấp khi triển khai Tuần 2)
# ------------------------------------------------------------------------------
OPENWEATHERMAP_API_KEY=your_open_weather_map_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Internal sync endpoint protection (Task W2-03) — chỉ dùng cho dev/ops local
INTERNAL_SYNC_SECRET=change_me_local_dev_secret

# Admin API key cho CRUD ngưỡng cảnh báo (Task W4-01) — gửi qua header X-Admin-Api-Key
# Sinh key: openssl rand -hex 32
ADMIN_API_KEY=change_me_admin_api_key

# ------------------------------------------------------------------------------
# 6. EMAIL NOTIFICATION SUBSCRIPTION (Mailpit Local mặc định hoặc Gmail/SMTP thật)
# ------------------------------------------------------------------------------
# Mặc định Local Dev dùng container Mailpit (xem hộp thư đến trực quan tại http://localhost:8025).
# Nếu dùng Gmail thật: đặt MAIL_HOST=smtp.gmail.com, MAIL_PORT=587, MAIL_SMTP_AUTH=true,
# MAIL_SMTP_STARTTLS=true, kèm MAIL_USERNAME và App Password 16 ký tự ở MAIL_PASSWORD.
MAIL_ENABLED=true
MAIL_HOST=localhost
MAIL_PORT=1025
MAILPIT_UI_PORT=8025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_FROM=no-reply@weathergis.vn
PUBLIC_WEB_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:8080
