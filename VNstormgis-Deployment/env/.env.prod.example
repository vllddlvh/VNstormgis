# ==============================================================================
# VIETNAM WEATHER WEBGIS — PRODUCTION ENVIRONMENT TEMPLATE (.env.prod.example)
# Copy to VNstormgis-Deployment/env/.env.prod on the production server (NEVER commit .env.prod)
# ==============================================================================

# 1. SPATIAL DATABASE (PostgreSQL 16 + PostGIS 3.4 / AWS RDS)
DB_HOST=db
DB_PORT=5432
DB_NAME=weather_gis_db
DB_USERNAME=gis_prod_user
DB_PASSWORD=replace_with_strong_random_db_password

# 2. DISTRIBUTED CACHE & RATE LIMITING (Redis 7.2)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_CACHE_ENABLED=true
REDIS_MAXMEMORY=256mb
REDIS_MAXMEMORY_POLICY=volatile-lru
CHAT_RATELIMIT_TRUSTED_PROXIES=172.16.0.0/12,10.0.0.0/8,127.0.0.1

# 3. EXTERNAL DATA & GROUNDED AI PROVIDERS
OPENWEATHERMAP_API_KEY=replace_with_openweathermap_key
GEMINI_ENABLED=true
GEMINI_API_KEY=replace_with_gemini_key
GEMINI_MODEL=gemini-2.5-flash

# 4. SECURITY SECRETS (Generate via: openssl rand -hex 32)
INTERNAL_SYNC_SECRET=replace_with_random_64_hex_sync_secret
ADMIN_API_KEY=replace_with_random_64_hex_admin_key

# 5. SMTP EMAIL NOTIFICATION SERVICE (Gmail App Password / AWS SES / Resend)
MAIL_ENABLED=true
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your.alert.sender@gmail.com
MAIL_PASSWORD=replace_with_smtp_app_password
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_FROM=no-reply@weathergis.vn
PUBLIC_WEB_URL=https://weathergis.vn
PUBLIC_API_URL=https://weathergis.vn

# 6. INGRESS PORT
WEB_PORT=80
